{
  "name": "gather-desktop",
  "productName": "Gather",
  "version": "1.0.0",
  "description": "Gather video calls for Windows",
  "main": "main.js",
  "author": "Gather",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uk.gathercall.desktop",
    "productName": "Gather",
    "directories": { "output": "dist" },
    "files": ["main.js", "picker.html", "picker.js", "picker-preload.js", "icon.ico"],
    "win": { "target": ["nsis"], "icon": "icon.ico", "artifactName": "Gather-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Gather" }
  }
}
