{
  "appId": "uk.gathercall.desktop",
  "productName": "Gather",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "picker.html",
    "picker.js",
    "picker-preload.js",
    "icon.ico",
    "quiz-icon.ico"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "icon.ico",
    "artifactName": "Gather-Setup.${ext}"
